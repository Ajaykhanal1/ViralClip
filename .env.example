# ---------------------------------------------------------------------------
# ViralClip AI - copy this file to .env before starting anything.
# .env is gitignored. Compose reads it too.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# Frontend (inlined at build time by next.config.ts)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend API
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

# Auth. AUTH_ACCESS_SECRET must be 32+ chars and identical for the API and web proxy.
# Leave it unset in development to use the shared dev-only fallback. Production refuses that
# fallback, so generate a unique value there.
# AUTH_ACCESS_SECRET=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
# Set only when the web app and API share a parent domain (for example .viralclip.ai).
AUTH_COOKIE_DOMAIN=

# Email. Without SMTP_HOST, development logs verification and reset links to the API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ViralClip <no-reply@viralclip.local>

# MySQL 8 (credentials match docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=viralclip
DB_PASSWORD=viralclip_dev_password
DB_NAME=viralclip
DB_POOL_LIMIT=10
MYSQL_ROOT_PASSWORD=viralclip_root_password

# Redis (queue + BullMQ)
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

# Worker
WORKER_CONCURRENCY=2
WORKER_HEALTH_PORT=4001
PROCESSING_TEMP_DIR=./storage/tmp

# AI engine (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Storage: "local" for development. S3 values are used once STORAGE_DRIVER=s3.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=1073741824
UPLOAD_SESSION_TTL_MINUTES=60
YOUTUBE_API_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
