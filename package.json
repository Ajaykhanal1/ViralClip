{
  "name": "viralclip-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered YouTube Shorts creation platform",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,yellow,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w @viralclip/web",
    "dev:api": "npm run dev -w @viralclip/api",
    "dev:worker": "npm run dev -w @viralclip/worker",
    "dev:ai": "python -m uvicorn app.main:app --reload --port 8000 --app-dir services/ai",
    "build": "npm run build -w @viralclip/shared && npm run build -w @viralclip/api && npm run build -w @viralclip/worker && npm run build -w @viralclip/web",
    "start:api": "npm run start -w @viralclip/api",
    "start:worker": "npm run start -w @viralclip/worker",
    "start:web": "npm run start -w @viralclip/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build -w @viralclip/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @viralclip/api",
    "db:status": "npm run db:status -w @viralclip/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "postinstall": "npm run build -w @viralclip/shared"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
